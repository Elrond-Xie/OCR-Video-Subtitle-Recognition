#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
STATE="$ROOT/.ocr-environment"
TOOLS="$ROOT/.tools"
ENVS="$ROOT/.envs"

COLOR_RESET=""
COLOR_GREEN=""
COLOR_YELLOW=""
COLOR_RED=""
COLOR_CYAN=""
if [[ -t 1 && -n "${TERM:-}" && "$TERM" != dumb && -z "${NO_COLOR+x}" ]]; then
  color_count=0
  if command -v tput >/dev/null 2>&1; then
    color_count="$(tput colors 2>/dev/null || printf '0')"
  elif [[ "$TERM" =~ ^(xterm|screen|tmux|rxvt|linux|ansi|cygwin|konsole|alacritty) ]]; then
    color_count=8
  fi
  if [[ "$color_count" =~ ^[0-9]+$ ]] && (( color_count >= 8 )); then
    COLOR_RESET=$'\033[0m'
    COLOR_GREEN=$'\033[32m'
    COLOR_YELLOW=$'\033[33m'
    COLOR_RED=$'\033[31m'
    COLOR_CYAN=$'\033[36m'
  fi
fi

say() { printf '%s%s%s\n' "$1" "$2" "$COLOR_RESET"; }
ok() { say "$COLOR_GREEN" "[OK] $1"; }
info() { say "$COLOR_CYAN" "[INFO] $1"; }
warn() { say "$COLOR_YELLOW" "[MISSING] $1"; }
fail() { say "$COLOR_RED" "[ERROR] $1" >&2; }

setup=0
assume_yes=0
for argument in "$@"; do
  case "$argument" in
    --setup) setup=1 ;;
    --yes|-y) assume_yes=1 ;;
    --help|-h)
      cat <<'USAGE'
Usage:
  ./configure                 Check dependencies and environment status
  ./configure --setup         Install the project OCR environment
  ./configure --setup --yes   Install without confirmation prompts
USAGE
      exit 0
      ;;
    *) fail "Unknown option: $argument"; exit 2 ;;
  esac
done
if (( assume_yes && ! setup )); then
  fail '--yes is valid only together with --setup.'
  exit 2
fi

if [[ "$(uname -s)" != Linux || "$(uname -m)" != x86_64 ]]; then
  fail 'This configure script supports Linux x86_64 only.'
  exit 1
fi

if (( ! setup )); then
  info 'Checking Linux OCR environment dependencies.'
  missing_system_tools=0
  if command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1; then
    ok 'A download utility (curl or wget) is available.'
  else
    warn 'No download utility (curl or wget) is available; installation may need a system package manager.'
    missing_system_tools=1
  fi
  if command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1; then
    ok 'A SHA-256 utility is available.'
  else
    warn 'No SHA-256 utility (sha256sum or shasum) is available; installation may need a system package manager.'
    missing_system_tools=1
  fi
  if command -v micromamba >/dev/null 2>&1 || [[ -x "$TOOLS/micromamba" ]]; then
    ok 'micromamba is available.'
  else
    info 'micromamba is not installed; --setup will download it into .tools/ (no administrator access needed).'
  fi
  if [[ -f "$STATE" ]]; then
    # The state file is generated by configure and contains only mode/prefix assignments.
    source "$STATE"
    if [[ -d "${prefix:-}" ]]; then
      ok "An OCR environment is configured ($mode)."
      if command -v micromamba >/dev/null 2>&1; then
        MAMBA="$(command -v micromamba)"
      else
        MAMBA="$TOOLS/micromamba"
      fi
      export MAMBA_ROOT_PREFIX="$TOOLS/mamba-root"
      if "$MAMBA" run -p "$prefix" python -c 'import av, faster_whisper, onnxruntime, psutil, rapidocr, yt_dlp; import paddle; from paddleocr import PaddleOCRVL; import shutil; assert shutil.which("ffmpeg") and shutil.which("ffprobe")' >/dev/null 2>&1; then
        ok 'Application, RapidOCR, Paddle, and PaddleOCR-VL Python dependencies import successfully.'
      else
        warn 'One or more Python dependencies are missing or cannot import; run ./configure --setup.'
      fi
    else
      warn 'The saved OCR environment directory is missing; run ./configure --setup.'
    fi
  else
    warn 'No OCR environment is configured; run ./configure --setup.'
  fi
  if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
    ok "NVIDIA GPU detected: $(nvidia-smi --query-gpu=name --format=csv,noheader | head -n1)"
  else
    info 'NVIDIA GPU not detected; setup will configure CPU fallback.'
  fi
  if (( missing_system_tools )); then
    info 'Use ./configure --setup to install required system utilities only if local alternatives are unavailable.'
  fi
  info 'Dependency check complete. Use ./configure --setup [--yes] to install the OCR environment.'
  exit 0
fi

if (( ! assume_yes )); then
  printf 'Install or replace the project-local OCR environment? [y/N] '
  read -r answer
  case "$answer" in
    y|Y|yes|YES) ;;
    *) info 'Installation cancelled.'; exit 0 ;;
  esac
fi

ensure_system_installer_tools() {
  if { command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1; } && \
    { command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1; }; then
    return 0
  fi
  if (( EUID != 0 )) && ! command -v sudo >/dev/null 2>&1; then
    fail 'curl/coreutils are missing and sudo is unavailable. Install these system packages, then rerun ./configure --setup.'
    return 1
  fi
  if command -v apt-get >/dev/null 2>&1; then
    if (( EUID == 0 )); then
      apt-get update && apt-get install -y curl coreutils
    elif (( assume_yes )); then
      sudo -n apt-get update && sudo -n apt-get install -y curl coreutils || {
        fail 'System tools need administrator access. Run ./configure --setup interactively or install curl and coreutils first.'
        return 1
      }
    else
      sudo apt-get update && sudo apt-get install -y curl coreutils
    fi
  elif command -v dnf >/dev/null 2>&1; then
    if (( EUID == 0 )); then
      dnf install -y curl coreutils
    elif (( assume_yes )); then
      sudo -n dnf install -y curl coreutils || { fail 'Could not install curl/coreutils with non-interactive sudo.'; return 1; }
    else
      sudo dnf install -y curl coreutils
    fi
  elif command -v yum >/dev/null 2>&1; then
    if (( EUID == 0 )); then
      yum install -y curl coreutils
    elif (( assume_yes )); then
      sudo -n yum install -y curl coreutils || { fail 'Could not install curl/coreutils with non-interactive sudo.'; return 1; }
    else
      sudo yum install -y curl coreutils
    fi
  elif command -v zypper >/dev/null 2>&1; then
    if (( EUID == 0 )); then
      zypper --non-interactive install curl coreutils
    elif (( assume_yes )); then
      sudo -n zypper --non-interactive install curl coreutils || { fail 'Could not install curl/coreutils with non-interactive sudo.'; return 1; }
    else
      sudo zypper --non-interactive install curl coreutils
    fi
  elif command -v pacman >/dev/null 2>&1; then
    if (( EUID == 0 )); then
      pacman -Sy --noconfirm curl coreutils
    elif (( assume_yes )); then
      sudo -n pacman -Sy --noconfirm curl coreutils || { fail 'Could not install curl/coreutils with non-interactive sudo.'; return 1; }
    else
      sudo pacman -Sy --noconfirm curl coreutils
    fi
  else
    fail 'No supported system package manager can install curl/coreutils.'
    return 1
  fi
}

ensure_system_installer_tools
mkdir -p "$TOOLS" "$ENVS"
source "$ROOT/environment/ocr-versions.env"

download_file() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$1" -o "$2"
  else
    wget -q "$1" -O "$2"
  fi
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1"
  else
    shasum -a 256 "$1"
  fi
}

if command -v micromamba >/dev/null 2>&1; then
  MAMBA="$(command -v micromamba)"
else
  MAMBA="$TOOLS/micromamba"
  if [[ ! -x "$MAMBA" ]]; then
    release='https://github.com/mamba-org/micromamba-releases/releases/latest/download'
    download_file "$release/micromamba-linux-64" "$TOOLS/micromamba.new"
    download_file "$release/micromamba-linux-64.sha256" "$TOOLS/micromamba.sha256"
    read -r expected _ < "$TOOLS/micromamba.sha256"
    read -r actual _ < <(sha256_file "$TOOLS/micromamba.new")
    if [[ "${expected,,}" != "${actual,,}" ]]; then
      rm -f "$TOOLS/micromamba.new"
      fail 'micromamba checksum verification failed.'
      exit 1
    fi
    mv "$TOOLS/micromamba.new" "$MAMBA"
    chmod 755 "$MAMBA"
  fi
fi
export MAMBA_ROOT_PREFIX="$TOOLS/mamba-root"

create_base() {
  local prefix="$1"
  "$MAMBA" create -y -p "$prefix" -c conda-forge "python=$PYTHON_VERSION" pip ffmpeg || return 1
  "$MAMBA" run -p "$prefix" python -m pip install --upgrade pip || return 1
  "$MAMBA" run -p "$prefix" python -m pip install -e "$ROOT" || return 1
}

gpu_ok=0
if command -v nvidia-smi >/dev/null 2>&1; then
  gpu_info="$(nvidia-smi --query-gpu=name,driver_version,compute_cap --format=csv,noheader 2>/dev/null | head -n1 || true)"
  if [[ -n "$gpu_info" ]]; then
    info "NVIDIA GPU detected: $gpu_info"
    gpu_prefix="$ENVS/ocr-gpu"
    rm -rf "$gpu_prefix"
    if create_base "$gpu_prefix" && \
      "$MAMBA" run -p "$gpu_prefix" python -m pip install "paddlepaddle-gpu==$PADDLE_VERSION" -i "$CUDA_INDEX_URL" && \
      "$MAMBA" run -p "$gpu_prefix" python -m pip install "paddleocr[doc-parser]==$PADDLEOCR_VERSION" && \
      "$MAMBA" run -p "$gpu_prefix" python -c 'import paddle; assert paddle.device.cuda.device_count() > 0' && \
      "$MAMBA" run -p "$gpu_prefix" python -c 'from paddleocr import PaddleOCRVL; PaddleOCRVL(device="gpu:0")'; then
      printf 'mode=gpu\nprefix=%q\n' "$gpu_prefix" > "$STATE"
      gpu_ok=1
      ok "Selected OCR environment: GPU ($gpu_prefix)"
    else
      warn 'GPU OCR setup or initialization failed; removing the GPU environment and falling back to CPU.'
      rm -rf "$gpu_prefix"
    fi
  fi
fi

if [[ "$gpu_ok" -eq 0 ]]; then
  cpu_prefix="$ENVS/ocr-cpu"
  rm -rf "$cpu_prefix"
  if ! create_base "$cpu_prefix" || \
    ! "$MAMBA" run -p "$cpu_prefix" python -m pip install "paddlepaddle==$PADDLE_VERSION" -i "$CPU_INDEX_URL" || \
    ! "$MAMBA" run -p "$cpu_prefix" python -m pip install "paddleocr[doc-parser]==$PADDLEOCR_VERSION" || \
    ! "$MAMBA" run -p "$cpu_prefix" python -c 'import paddle, rapidocr; import video_subtitles.cli'; then
    rm -rf "$cpu_prefix"
    fail 'CPU OCR environment setup failed. See the package manager output above.'
    exit 1
  fi
  printf 'mode=cpu\nprefix=%q\n' "$cpu_prefix" > "$STATE"
  ok "Selected OCR environment: CPU ($cpu_prefix)"
fi

ok "Environment selection saved to $STATE"
