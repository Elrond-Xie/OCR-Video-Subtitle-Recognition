# Python runtime version used to create the isolated OCR environment.
PYTHON_VERSION=3.11
# Fixed Miniforge release installed by the Linux setup script.
MINIFORGE_VERSION=26.7.2-0
# PaddleOCR package version that provides PaddleOCR-VL and its document parser.
PADDLEOCR_VERSION=3.7.0
# PaddlePaddle runtime version; GPU and CPU installs use this exact version.
PADDLE_VERSION=3.3.0
# Versions validated for the isolated NVIDIA inference service.
VLLM_VERSION=0.11.1
TORCH_C_DLPACK_EXT_VERSION=0.1.5
# Conda-forge CPU llama.cpp build used by the local CPU OCR service.
LLAMA_CPP_VERSION=11351
LLAMA_CPP_BUILD=cpu_mkl_hc2f5b01_0
# Pinned PaddleOCR-VL-1.6 GGUF model and mmproj checksums from Hugging Face.
OCR_GGUF_MODEL_SHA256=f3ae46ec885050acf4b3d31944431e1fd90d50664fb09126af4a3c050ba14ee8
OCR_GGUF_MMPROJ_SHA256=204d757d7610d9b3faab10d506d69e5b244e32bf765e2bab2d0167e65e0a058a
# Official Python package index for the CPU-only Paddle client runtime. Inference
# runs in an isolated llama.cpp CPU or vLLM/PyTorch NVIDIA service environment.
CPU_INDEX_URL=https://www.paddlepaddle.org.cn/packages/stable/cpu/
# Root directory for downloaded packages and model files. Relative paths are
# resolved from the project root; absolute paths are also supported. Quote a
# value that contains spaces, for example: DOWNLOAD_DIR="/data/ocr downloads".
DOWNLOAD_DIR=downloads
# Directory for project logs. Relative paths are resolved from the project root;
# absolute paths are supported. Logs are separated into configure/ and run/.
LOG_DIR=logs
# Save configuration and runtime output to local log files (true or false).
SAVE_LOGS=true
